# ==============================================================================
# TradeTwin Environment Configuration Template
# Copy this file to .env and configure your values for local or production use.
# ==============================================================================

# Server & Networking
PORT=8080
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
# Local Docker or local service: mongodb://localhost:27017/tradetwin
# Cloud MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/tradetwin?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/tradetwin

# Security & Authentication
# Min 256-bit base64/hex secret for HMAC-SHA256 JWT signing
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Google Gemini Runtime AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# PayPal Sandbox Orders API v2
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
PAYPAL_DELEGATED_VAULT_ENABLED=false
